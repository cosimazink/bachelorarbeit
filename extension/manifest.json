{
    "manifest_version": 3,
    "name": "UI Extractor – Prototype",
    "version": "0.0.1",
    "description": "Prototype: Browserextension with Selector for UI-Elements",
    "action": {
        "default_popup": "popup.html",
        "default_title": "UI Extractor"
    },
    "permissions": [
        "tabs",
        "storage"
    ],
    "host_permissions": [
        "http://localhost:8787/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "src/scripts/contentScript.js"
            ],
            "css": [
                "src/styles/content.css"
            ],
            "run_at": "document_idle",
            "all_frames": true
        }
    ]
}